{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current file (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug.exe",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "externalConsole": false,
            "stopAtEntry": false,
            "preLaunchTask": "Build current file (debug)",
            "setupCommands": [
                { "description": "Pretty printing for STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
